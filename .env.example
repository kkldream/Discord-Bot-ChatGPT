# Copy to .env locally. Do not commit credentials. Node 24.21.0 / npm 11.19.0.
# openai remains the default; only the selected provider key is required.
AI_PROVIDER=openai
OPENAI_API_KEY=replace-openai-key
# Required only when AI_PROVIDER=gemini. Set an explicitly reviewed text model.
GEMINI_API_KEY=replace-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
# No third-party GEMINI_BASE_URL is accepted; credentials only go to Google.
DISCORD_BOT_TOKEN=replace-discord-token
# Needed only for explicit command registration, not for normal startup:
DISCORD_BOT_CLIENT_ID=replace-application-id
# DISCORD_COMMAND_GUILD_ID=000000000000000000
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=dcbot_chatgpt
OPENAI_MODEL=gpt-4.1-nano
# Set at least one real user/guild ID. Empty lists do not enable public access.
ALLOWED_USER_IDS=
ALLOWED_GUILD_IDS=
ALLOWED_CHANNEL_IDS=
ALLOW_PUBLIC_ACCESS=false
ENABLE_DMS=true
# AI_TIMEOUT_MS applies to both providers; OPENAI_TIMEOUT_MS remains a fallback.
AI_TIMEOUT_MS=30000
MAX_OUTPUT_TOKENS=2048
MAX_OUTPUT_BYTES=262144
MAX_CONTEXT_BYTES=32768
MAX_CONTEXT_MESSAGES=41
MAX_CHAIN_DEPTH=40
REQUESTS_PER_MINUTE=5
GLOBAL_REQUESTS_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=4
MAX_PENDING_PER_USER=8
MAX_PENDING_TOTAL=100
READINESS_PORT=8080
SHUTDOWN_TIMEOUT_MS=45000

{
  "name": "discord-bot-chatgpt",
  "version": "0.0.1",
  "main": "index.js",
  "author": "kkldream <kk69347321@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "check:config": "node index.js --check-config",
    "register-commands": "node scripts/register-commands.js",
    "lint": "eslint .",
    "test": "node --require ./test/no-network.cjs --test test/*.test.js",
    "test:coverage": "node --require ./test/no-network.cjs --experimental-test-coverage --test test/*.test.js",
    "test:baseline": "node --test scripts/baseline-regressions.cjs",
    "verify": "npm run lint && npm run check:secrets && npm test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "sbom": "node scripts/sbom.js",
    "check:secrets": "node scripts/check-secrets.js"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "18.0.5",
    "mongodb": "7.7.0",
    "openai": "7.27.0"
  },
  "packageManager": "npm@11.19.0",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "devDependencies": {
    "eslint": "10.12.0"
  }
}
